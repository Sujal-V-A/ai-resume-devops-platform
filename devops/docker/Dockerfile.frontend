# --- Build Stage ---
FROM node:20-alpine AS build
WORKDIR /app
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ ./
RUN npm run build

# --- Production Stage ---
FROM nginx:stable-alpine
COPY --from=build /app/dist /usr/share/nginx/html
# Copy default custom nginx config if needed, or expose port 80
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
